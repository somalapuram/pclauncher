<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.somalapuram.pclauncher.core.apps">

    <!--
      Recency ordering (SRS §11). An appop permission: declaring it is not enough — the user grants
      it in Settings, and the shell must rank sensibly when they have not. See UsageSignals, which
      falls through to our own launch counters.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Package visibility. Deliberately a <queries> declaration rather than QUERY_ALL_PACKAGES:
      the inventory only ever needs apps that have a launcher entry, and this says exactly that.
      QUERY_ALL_PACKAGES would additionally expose every package with no launchable activity —
      strictly more than a launcher needs, and more than we want to be able to see.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
