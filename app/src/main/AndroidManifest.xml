<?xml version="1.0" encoding="utf-8"?>
<!--
  NOTE (aosp branch): the package attribute below is what makes this manifest
  usable by Soong, and is exactly why this branch exists.

  Soong requires the main manifest to declare a package:
      Main AndroidManifest.xml manifest:package attribute is not declared
  while the Gradle build takes it from `namespace` in app/build.gradle.kts and
  AGP 8 rejects this attribute outright. The two cannot both be satisfied by
  one manifest, so main carries the Gradle form and this branch carries the
  Soong form. Keep it in step with the namespace on main.

  xmlns:tools comes from main and is kept: tools:ignore is used on the
  protected permissions below, so dropping the namespace would break the
  manifest rather than merely lose a lint hint.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.somalapuram.pclauncher">

    <!--
      SRS §3: no INTERNET permission. v1 has no network, no accounts, no telemetry.
      Deliberately absent, not forgotten.
    -->

    <!--
        All three are signature|privileged, so an ordinary build is simply not granted them and the
        features behind them fall back: the Start menu's device-power controls stay disabled with
        the reason shown, and adding a widget goes through the system's bind dialog instead of
        binding silently. The AOSP branch signs the app with the platform key, the same binary is
        granted them, and those paths become the direct ones with no code change
        (start-power.md, widget-host.md, SRS §5.2).

        `ProtectedPermissions` is suppressed rather than baselined: lint is right that an ordinary
        app cannot hold these, and that is the whole design — the declaration is what lets the
        privileged build be granted them, and the UI is written to expect the denial.
    -->
    <!--
        The chrome floats over other windows from a foreground service. SYSTEM_ALERT_WINDOW is a
        *special* permission an ordinary app may hold once the user grants it in Settings, which is
        why the overlay needs no AOSP build (overlay-service.md, SRS §5.1).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.SHUTDOWN"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PcLauncherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PcLauncher">

        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.PcLauncher"
            android:windowSoftInputMode="adjustNothing">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!--
                  LAUNCHER keeps pclauncher reachable from whatever launcher is currently default,
                  so it can be opened and set as home during Stage A development. Drop this in
                  Stage B, where pclauncher *is* the home app and an icon in its own drawer is noise.
                -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.ShellOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="The launcher's own dock, Start menu and system tray, which must stay
                    visible above app windows" />
        </service>
    </application>
</manifest>
