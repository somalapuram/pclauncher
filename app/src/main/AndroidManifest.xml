<?xml version="1.0" encoding="utf-8"?>
<!--
  NOTE (aosp branch): the package attribute below is what makes this manifest
  usable by Soong, and is exactly why this branch exists.

  Soong requires the main manifest to declare a package:
      Main AndroidManifest.xml manifest:package attribute is not declared
  while the Gradle build takes it from `namespace` in app/build.gradle.kts and
  AGP 8 rejects this attribute outright. The two cannot both be satisfied by
  one manifest, so main carries the Gradle form and this branch carries the
  Soong form. Keep it in step with the namespace on main.

  xmlns:tools comes from main and is kept: tools:ignore is used on the two
  protected permissions below, so dropping the namespace would break the
  manifest rather than merely lose a lint hint.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.somalapuram.pclauncher">

    <!--
      SRS §3: no INTERNET permission. v1 has no network, no accounts, no telemetry.
      Deliberately absent, not forgotten.
    -->

    <!--
        Both are signature|privileged, so an ordinary build is simply not granted them and the
        Start menu's device-power controls stay disabled with the reason shown. The AOSP branch
        signs and allowlists the app, the same binary is granted them, and the controls become live
        with no code change (start-power.md, SRS §5.2).

        `ProtectedPermissions` is suppressed rather than baselined: lint is right that an ordinary
        app cannot hold these, and that is the whole design — the declaration is what lets the
        privileged build be granted them, and the UI is written to expect the denial.
    -->
    <uses-permission
        android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.SHUTDOWN"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PcLauncherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PcLauncher">

        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.PcLauncher"
            android:windowSoftInputMode="adjustNothing">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!--
                  LAUNCHER keeps pclauncher reachable from whatever launcher is currently default,
                  so it can be opened and set as home during Stage A development. Drop this in
                  Stage B, where pclauncher *is* the home app and an icon in its own drawer is noise.
                -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
